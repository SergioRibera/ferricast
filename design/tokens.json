{
  "primitive": {
    "color": {
      "iron": {
        "50":  "#F6F1EC",
        "100": "#E8DED2",
        "300": "#B0A090",
        "500": "#6C5D4E",
        "700": "#3A3128",
        "900": "#1C1814"
      },
      "ember": {
        "300": "#E88057",
        "500": "#C85A2D",
        "700": "#8A3B1A"
      },
      "steel": {
        "50":  "#F2F5F8",
        "500": "#5F6B78",
        "900": "#0E1218",
        "surface.dark":     "#161B22",
        "surface.alt.dark": "#1D232C",
        "border.dark":      "#262C35",
        "fg.muted.dark":    "#9AA4B1"
      },
      "signal": {
        "cast":  "#C85A2D",
        "ready": "#4F8F6B",
        "warn":  "#C89A2D",
        "error": "#B7311F"
      },
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "space": {"4":4,"8":8,"12":12,"16":16,"20":20,"24":24,"32":32,"48":48,"64":64,"96":96},
    "radius": {"xs":4,"sm":8,"md":12,"lg":16,"pill":9999},
    "font": {
      "family": {"sans": "Inter, system-ui, sans-serif", "mono": "JetBrains Mono, ui-monospace, monospace"},
      "weight": {"regular": 400, "medium": 500, "bold": 700},
      "size":   {"caption":11,"mono":12,"body":13,"body.lg":15,"h2":18,"h1":24,"display":40},
      "line":   {"caption":16,"mono":18,"body":20,"body.lg":22,"h2":24,"h1":32,"display":48}
    },
    "motion": {
      "duration": {"state":120,"exit":140,"enter":180,"breathing":1600},
      "easing":   {"enter":"cubic-bezier(.2,.9,.2,1)","exit":"cubic-bezier(.4,0,.6,1)","state":"linear"}
    },
    "shadow": {"overlay":"0 10 28 rgba(0,0,0,0.18)"}
  },
  "semantic": {
    "light": {
      "bg.canvas":      "{iron.50}",
      "bg.surface":     "{white}",
      "bg.surface.alt": "{iron.100}",
      "fg.default":     "{iron.900}",
      "fg.muted":       "{iron.500}",
      "fg.subtle":      "{iron.300}",
      "accent":         "{ember.500}",
      "accent.fg":      "{white}",
      "border":         "{iron.100}",
      "focus.ring":     "{ember.500}"
    },
    "dark": {
      "bg.canvas":      "{steel.900}",
      "bg.surface":     "{steel.surface.dark}",
      "bg.surface.alt": "{steel.surface.alt.dark}",
      "fg.default":     "{iron.50}",
      "fg.muted":       "{steel.fg.muted.dark}",
      "fg.subtle":      "{steel.500}",
      "accent":         "{ember.500}",
      "accent.fg":      "{iron.900}",
      "border":         "{steel.border.dark}",
      "focus.ring":     "{ember.300}"
    }
  },
  "component": {
    "tray.popup":    {"bg":"{bg.surface}","padding":"{space.16}","radius":"{radius.md}","gap":"{space.8}","minWidth":320,"maxHeight":480},
    "device.card":   {"bg":"{bg.surface}","padding":"{space.12}","radius":"{radius.sm}","gap":"{space.12}","minHeight":56},
    "device.card.live":{"bg":"{bg.surface}","border":"{accent}","padding":"{space.12}","radius":"{radius.sm}"},
    "button.primary":{"bg":"{accent}","fg":"{accent.fg}","padding":"{space.8} {space.16}","radius":"{radius.sm}","minHeight":40},
    "button.ghost":  {"bg":"transparent","fg":"{fg.default}","padding":"{space.8} {space.12}","radius":"{radius.sm}","minHeight":40},
    "chip":          {"bg":"{bg.surface.alt}","fg":"{fg.default}","padding":"{space.4} {space.8}","radius":"{radius.pill}"},
    "receiver.hero": {"bg":"{bg.canvas}","padding":"{space.64}","fgTitle":"{fg.default}","fgCode":"{accent}"}
  }
}
